{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "globalDependencies": ["packages/tsconfig/*.json", "eslint.config.mjs", ".prettierrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "NODE_ENV"]
    },
    "lint": { "dependsOn": ["^build"], "outputs": [], "cache": false },
    "typecheck": { "dependsOn": ["^build"], "outputs": [], "cache": false },
    "test": { "dependsOn": ["^build"], "outputs": [], "cache": false }
  }
}

# Kabuki Neko: local single-instance defaults. Docker sets NODE_ENV=production.
# Supply environment via your shell, Node --env-file, or Compose env_file.
# Keep driver overrides commented so DEPLOYMENT_PROFILE=scale can select its defaults.
NODE_ENV=development
DEPLOYMENT_PROFILE=default
DEPLOYMENT_TOPOLOGY=single
# DEPLOYMENT_INSTANCE_ID=<unique canonical UUIDv4 per process; generated if absent>
NEXT_PUBLIC_APP_NAME="Kabuki Neko"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
API_PORT=3001
# PORT=3001 # Compatibility alias; when both are set they must match.
# Exact browser origins, comma-separated, without trailing slash or wildcard.
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_CIDRS=[]

# Access15m, refresh7d absolute family lifetime; protocol constants are validated.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Leave secrets absent for secure single-instance generation and persistence.
# Explicit values must be distinct, random, >=64 characters; examples are rejected.
# JWT_ACCESS_SECRET=<provisioned random secret>
# JWT_REFRESH_SECRET=<different provisioned random secret>
# APP_SECRET_FILE=/absolute/path/to/runtime-secrets.json
# Default: project data/runtime-secrets.json locally; /app/data/runtime-secrets.json in production.
# Multi-instance: provision the same valid0600 secret file on every node before startup,
# or inject the same access/refresh pair on every node. No per-node auto-generation.

# Profile default: sqlite/memory/local; profile scale: postgres/redis/s3.
# DB_DRIVER=sqlite
DB_AUTO_MIGRATE=true
# SQLITE_PATH=/absolute/path/to/kabuki-neko.sqlite
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# Required for postgres/mysql; scale does not inject database credentials.
DB_POOL_MAX=20
# STATE_DRIVER=memory
# REDIS_URL=redis://localhost:6379
# Scale default REDIS_URL=redis://redis:6379; use TLS/ACL for remote/private deployments.
REDIS_CLUSTER_NODES=[]
# To use cluster, supply JSON redis/rediss URL array and leave REDIS_URL unset.
STATE_NAMESPACE=default
# MAX_ACTIVE_ROOMS=20
# Default:20 for memory,200 for Redis; allowed1..10000, not a capacity certification.
ROOM_MAX_AGE_SEC=28800
FINALIZE_CONCURRENCY=2
AUDIT_RETENTION_DAYS=30

# STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH=/absolute/path/to/uploads
LOCAL_STORAGE_SHARED=false
# Multi-instance requires postgres/mysql + redis; local storage also requires a
# genuinely shared filesystem mounted at the same absolute path on all nodes.
STORAGE_LOCATION_ID=active
# STORAGE_LOCATIONS_FILE=/absolute/path/to/storage-locations.json
# Required when using s3; provision your own credentials, not minioadmin samples.
# S3_ENDPOINT=https://<storage-host>
S3_REGION=auto
S3_BUCKET=kabuki-neko-media
# S3_ACCESS_KEY=<provisioned access key>
# S3_SECRET_KEY=<provisioned secret key>
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://<browser-reachable-media-host>/kabuki-neko-media
# ALLOW_INSECURE_LOCAL_HTTP=true
# Defaults true in development/test, false in production. Explicit local HTTP
# deployment can opt in; use TLS for production service/public traffic.

# Paired immutable build artifacts (validated when provider/asset tasks are wired).
# LOCALE_BUNDLE_PATH=/absolute/path/to/locales-built
# AUDIO_MANIFEST_PATH=/absolute/path/to/audio/audio-manifest.json
# Production defaults: /app/locales-built and /app/audio/audio-manifest.json.
# NEXT_PUBLIC_* URLs must resolve from the user's browser, never Docker-only names.
# API_INTERNAL_URL is server-only and may use the Compose service hostname.
# Driver/namespace changes require restart/draining; they do not migrate data.

# --- Docker Compose (docker/docker-compose.yml; docs/deployment.md) ---
# Compose reads these from the shell or `docker/.env`. Never put secrets here: the default
# profile generates its JWT secrets into the kabuki-data volume, and the scale profile generates
# every credential into the kabuki-secrets volume (secrets-init). There is no minioadmin sample.
# Profile: `pnpm deploy:scale` runs exactly
#   DEPLOYMENT_PROFILE=scale docker compose -f docker/docker-compose.yml --profile scale up -d --build
# DEPLOYMENT_PROFILE and `--profile scale` always go together; the driver overrides above stay
# commented so the profile selects postgres/redis/s3. Switching profiles does not move data.
# KN_PUBLIC_URL=https://quiz.example.org            # web origin as browsers see it
# KN_API_PUBLIC_URL=https://api.quiz.example.org    # API origin as browsers see it (same site)
# KN_MEDIA_PUBLIC_URL=https://media.quiz.example.org/kabuki-neko-media  # scale: public media
# KN_BIND_ADDRESS=127.0.0.1                         # ports bind here for a TLS reverse proxy
# KN_WEB_PORT=3000
# KN_API_PORT=3001
# KN_MEDIA_PORT=9000
# KN_IMAGE_TAG=local
# KN_MINIO_IMAGE=kabuki-neko/minio:9e49d5e7a648    # MinIO built from pinned upstream source
# TRUST_PROXY_CIDRS=["172.16.0.0/12"]               # the reverse proxy's addresses only

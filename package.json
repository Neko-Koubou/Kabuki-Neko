{
  "name": "kabuki-neko",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=10.34.9"
  },
  "scripts": {
    "build": "pnpm build:assets && turbo run build",
    "build:assets": "pnpm locales:build && pnpm assets:package --require-audio --require-locales --ensure-audio",
    "assets:package": "tsx scripts/package-assets.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "jest --config tests/jest.integration.config.cjs",
    "test:contracts": "jest --config tests/jest.contracts.config.cjs",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/performance",
    "locales:validate": "tsx scripts/locales-validate.ts",
    "locales:build": "tsx scripts/locales-build.ts",
    "locales:template": "tsx scripts/locales-template.ts",
    "audio:optimize": "node scripts/optimize-audio.mjs",
    "test:audio": "node --test scripts/optimize-audio.spec.mjs",
    "benchmark:game": "tsx scripts/benchmark-game.ts",
    "deploy:scale": "tsx scripts/start-profile.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@testcontainers/mysql": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "axe-core": "4.14.0",
    "better-sqlite3": "12.11.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "intl-messageformat": "12.1.4",
    "ioredis": "5.11.1",
    "jest": "30.5.2",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
